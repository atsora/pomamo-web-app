<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration, deployed at the root of the web app (staged by
  build/public.mjs, then harvested into INSTALLFOLDER by the MSI).

  It only declares image/webp: that type is missing from the default IIS MIME
  map before Windows Server 2022, so a customer-logo.webp dropped in images/
  answers 404.3 without this. .svg, .png and .jpg need no declaration.

  The <remove> before the <mimeMap> is required, not defensive tidiness: on
  Windows Server 2022 and later .webp IS in the inherited map, and adding it a
  second time fails the whole site with HTTP 500.19, "Cannot add duplicate
  collection entry". Removing first makes the file work on both.

  The <clientCache> block this file used to carry (a one minute max-age) is
  gone on purpose: the file was staged by nothing and so had never been
  deployed, and reviving that policy is a separate decision from serving .webp.

  Apache ignores this file, so it is harmless in the .deb.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
